# --- Database (Postgres) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/propel"

# --- App ---
# Public base URL of this app (no trailing slash). Used for client links, OAuth redirect & CRM card URLs.
APP_URL="http://localhost:3000"
# 32+ random chars. Used to encrypt the session cookie.  `openssl rand -base64 32`
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Secret shared with the HubSpot CRM card fetch (any random string, also pasted into the card config)
CRM_CARD_SECRET="change-me-too"

# --- HubSpot app (developer.hubspot.com -> your app -> Auth) ---
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
# Must match the redirect URL registered on the app: ${APP_URL}/api/hubspot/callback
HUBSPOT_SCOPES="oauth timeline crm.objects.deals.read crm.objects.deals.write crm.objects.contacts.read crm.objects.companies.read crm.objects.line_items.read crm.objects.owners.read"

# --- Email notifications (optional; leave blank to log to console) ---
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL="Propel <proposals@mybos.com>"

# --- Vercel deployment extras ---
# Vercel Blob (Storage → Create Blob store → token is added automatically). Without it, uploads go to ./public/uploads (dev only).
BLOB_READ_WRITE_TOKEN=""
# Protects /api/cron/stalled when called by Vercel Cron (Settings → Environment Variables; Vercel sends it as a Bearer token).
CRON_SECRET=""
# Optional: base URL the PDF renderer loads pages from (defaults to VERCEL_URL, then APP_URL).
PDF_RENDER_BASE_URL=""
# Optional: local Chromium path for PDF export in development (defaults to Playwright's bundled Chromium).
CHROME_PATH=""
