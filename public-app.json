{
  "name": "Propel Proposals",
  "uid": "propel-proposals",
  "description": "Create, send and track interactive proposals with e-signature from the deal record.",
  "logo": "./propel-logo.png",
  "auth": {
    "redirectUrls": ["https://YOUR-PROPEL-DOMAIN/api/hubspot/callback"],
    "requiredScopes": [
      "oauth",
      "crm.objects.deals.read",
      "crm.objects.deals.write",
      "crm.objects.contacts.read",
      "crm.objects.companies.read",
      "crm.objects.line_items.read",
      "crm.objects.owners.read"
    ],
    "optionalScopes": [],
    "conditionallyRequiredScopes": []
  },
  "support": {
    "supportEmail": "support@mybos.com",
    "documentationUrl": "https://YOUR-PROPEL-DOMAIN",
    "supportUrl": "https://YOUR-PROPEL-DOMAIN"
  },
  "extensions": {
    "crm": {
      "cards": [{ "file": "extensions/proposals-card.json" }]
    }
  },
  "permittedUrls": {
    "fetch": ["https://YOUR-PROPEL-DOMAIN"],
    "iframe": ["https://YOUR-PROPEL-DOMAIN"]
  }
}
